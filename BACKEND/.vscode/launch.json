{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BérAutó Flask",
      "type": "python",
      "request": "launch",
      "module": "flask",
      "env": {
        "FLASK_APP": "run_app.py",
        "FLASK_DEBUG": "1"
      },
      "args": [
        "run",
        "--host",
        "localhost",
        "--port",
        "8888"
      ],
      "jinja": true
    }
  ]
}
